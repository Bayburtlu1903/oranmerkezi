<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oranmerkezi - Detaylı Analiz & Korner</title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 15px; min-height: 100vh; }
        .container { max-width: 600px; margin: 0 auto; background: rgba(30, 41, 59, 0.95); padding: 25px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1); }
        h1 { text-align: center; color: #38bdf8; margin-top: 0; font-size: 24px; text-transform: uppercase; letter-spacing: 2px; }
        .form-group { margin-bottom: 14px; }
        label { display: block; margin-bottom: 5px; color: #cbd5e1; font-size: 13px; font-weight: 600; }
        input { width: 100%; padding: 10px 12px; background: #0f172a; border: 1px solid #334155; color: #fff; border-radius: 8px; font-size: 14px; }
        .row { display: flex; gap: 10px; }
        .col { flex: 1; }
        button { width: 100%; padding: 14px; background: linear-gradient(135deg, #06b6d4, #3b82f6); border: none; color: #fff; font-weight: bold; border-radius: 8px; cursor: pointer; font-size: 16px; margin-top: 15px; box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4); }
        
        .result-box { margin-top: 25px; display: none; }
        .match-header { font-size: 16px; font-weight: bold; color: #38bdf8; text-align: center; margin-bottom: 15px; padding-bottom: 8px; border-bottom: 1px solid #1e293b; }
        .section-title { font-size: 12px; color: #94a3b8; text-transform: uppercase; margin: 15px 0 8px 0; letter-spacing: 1px; }
        
        .stat-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
        .stat-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        
        .stat-card { background: #1e293b; padding: 12px; border-radius: 8px; text-align: center; }
        .stat-label { font-size: 11px; color: #94a3b8; text-transform: uppercase; }
        .stat-value { font-size: 16px; font-weight: bold; margin-top: 4px; }

        /* Farklı Renk Vurguları */
        .c-blue { border-left: 4px solid #38bdf8; }
        .c-amber { border-left: 4px solid #f59e0b; }
        .c-pink { border-left: 4px solid #ec4899; }
        .c-green { border-left: 4px solid #10b981; }
        .c-purple { border-left: 4px solid #8b5cf6; }
        .c-teal { border-left: 4px solid #14b8a6; }
        .c-rose { border-left: 4px solid #f43f5e; }
    </style>
</head>
<body>

<div class="container">
    <h1>Oranmerkezi</h1>
    
    <div class="row">
        <div class="col form-group"><label>Ev Sahibi</label><input type="text" id="homeTeam" placeholder="Ev Sahibi"></div>
        <div class="col form-group"><label>Deplasman</label><input type="text" id="awayTeam" placeholder="Deplasman"></div>
    </div>

    <div class="form-group">
        <label>Maç Sonu Oranları (MS 1 - 0 - 2)</label>
        <div class="row">
            <input type="number" step="0.01" id="ms1" placeholder="MS 1">
            <input type="number" step="0.01" id="ms0" placeholder="MS 0">
            <input type="number" step="0.01" id="ms2" placeholder="MS 2">
        </div>
    </div>

    <button onclick="calculateAnalysis()">Kapsamlı Korner & Maç Analizi</button>

    <div class="result-box" id="resultArea">
        <div class="match-header" id="headerText">Maç Analizi</div>
        
        <!-- Maç Sonu Bölümü -->
        <div class="section-title">Maç Sonu Yüzdeleri</div>
        <div class="stat-grid-3">
            <div class="stat-card c-blue"><div class="stat-label">MS 1</div><div class="stat-value" id="valMS1" style="color:#38bdf8;">%0</div></div>
            <div class="stat-card c-amber"><div class="stat-label">MS 0</div><div class="stat-value" id="valMS0" style="color:#f59e0b;">%0</div></div>
            <div class="stat-card c-pink"><div class="stat-label">MS 2</div><div class="stat-value" id="valMS2" style="color:#ec4899;">%0</div></div>
        </div>

        <!-- Korner Analizleri -->
        <div class="section-title">Korner Analizleri</div>
        <div class="stat-grid-2">
            <div class="stat-card c-green">
                <div class="stat-label">Ev Korner Baskısı</div>
                <div class="stat-value" id="valHomeCorner" style="color:#10b981;">-</div>
            </div>
            <div class="stat-card c-purple">
                <div class="stat-label">Deplasman Korner</div>
                <div class="stat-value" id="valAwayCorner" style="color:#8b5cf6;">-</div>
            </div>
        </div>
        
        <div class="stat-grid-2" style="margin-top: 8px;">
            <div class="stat-card c-teal">
                <div class="stat-label">İlk Yarı Korner (4.5 Alt/Üst)</div>
                <div class="stat-value" id="valIYCorner" style="color:#14b8a6;">-</div>
            </div>
            <div class="stat-card c-rose">
                <div class="stat-label">Toplam Korner (9.5 / 8.5)</div>
                <div class="stat-value" id="valTotalCorner" style="color:#fb7185;">-</div>
            </div>
        </div>

        <!-- Skor & Tahmin -->
        <div class="section-title">Genel Tahminler</div>
        <div class="stat-card c-blue" style="text-align: left; margin-top: 5px;">
            <div class="stat-label">İY / MS & Skor Tahmini</div>
            <div class="stat-value" id="valScores" style="color: #38bdf8; font-size: 13px; font-weight: normal; margin-top: 6px;">-</div>
        </div>
    </div>
</div>

<script>
    function calculateAnalysis() {
        const home = document.getElementById('homeTeam').value || 'Ev Sahibi';
        const away = document.getElementById('awayTeam').value || 'Deplasman';
        
        const m1 = parseFloat(document.getElementById('ms1').value) || 0;
        const m0 = parseFloat(document.getElementById('ms0').value) || 0;
        const m2 = parseFloat(document.getElementById('ms2').value) || 0;

        if (m1 === 0 || m2 === 0) {
            alert("Lütfen MS oranlarını girin!");
            return;
        }

        // Temel Yüzde Hesaplama
        let imp1 = 1 / m1, imp0 = m0 > 0 ? (1 / m0) : 0.28, imp2 = 1 / m2;
        let total = imp1 + imp0 + imp2;
        let p1 = (imp1 / total) * 100;
        let p0 = (imp0 / total) * 100;
        let p2 = (imp2 / total) * 100;

        // Korner Hesaplamaları (Oranlara Göre Dinamik Üretim)
        let avgOdd = (m1 + m2) / 2;
        let homeCornerCount = (p1 > p2) ? (6 + (p1/15)).toFixed(1) : (4 + (p1/20)).toFixed(1);
        let awayCornerCount = (p2 > p1) ? (6 + (p2/15)).toFixed(1) : (4 + (p2/20)).toFixed(1);
        let totalCornerVal = (parseFloat(homeCornerCount) + parseFloat(awayCornerCount)).toFixed(1);
        
        let iyCornerText = avgOdd < 2.2 ? "4.5 ÜST (%72)" : "4.5 ALT (%58)";
        let totalCornerText = totalCornerVal > 9.5 ? `${totalCornerVal} - 9.5 ÜST` : `${totalCornerVal} - 8.5 ÜST`;

        // Ekrana Yazdırma
        document.getElementById('headerText').innerText = `${home} vs ${away}`;
        document.getElementById('valMS1').innerText = `%${p1.toFixed(1)}`;
        document.getElementById('valMS0').innerText = `%${p0.toFixed(1)}`;
        document.getElementById('valMS2').innerText = `%${p2.toFixed(1)}`;

        document.getElementById('valHomeCorner').innerText = `${homeCornerCount} Korner`;
        document.getElementById('valAwayCorner').innerText = `${awayCornerCount} Korner`;
        document.getElementById('valIYCorner').innerText = iyCornerText;
        document.getElementById('valTotalCorner').innerText = totalCornerText;

        let iyPred = p1 > p2 ? "1/1" : (p2 > p1 ? "2/2" : "0/0");
        let msPred = p1 > p2 ? "MS 1" : (p2 > p1 ? "MS 2" : "MS 0");
        let scorePred = p1 > p2 ? "İY: 1-0 | MS: 2-1" : "İY: 0-1 | MS: 1-2";

        document.getElementById('valScores').innerText = `Tahmin: ${iyPred} / ${msPred} | ${scorePred}`;
        
        document.getElementById('resultArea').style.display = 'block';
    }
</script>

</body>
</html>

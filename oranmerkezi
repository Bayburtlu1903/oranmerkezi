<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oranmerkezi - Kapsamlı Analiz</title>
    <style>
        * { box-sizing: border-box; }
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background: linear-gradient(135deg, #0f172a, #1e1b4b); 
            color: #f8fafc; 
            margin: 0; 
            padding: 15px; 
            min-height: 100vh;
        }
        .container { 
            max-width: 600px; 
            margin: 0 auto; 
            background: rgba(30, 41, 59, 0.9); 
            backdrop-filter: blur(10px);
            padding: 25px; 
            border-radius: 16px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.5); 
            border: 1px solid rgba(255,255,255,0.1);
        }
        h1 { 
            text-align: center; 
            color: #38bdf8; 
            margin-top: 0; 
            font-size: 26px; 
            text-transform: uppercase; 
            letter-spacing: 2px; 
            text-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
        }
        .form-group { margin-bottom: 14px; }
        label { display: block; margin-bottom: 5px; color: #cbd5e1; font-size: 13px; font-weight: 600; }
        input[type="text"], input[type="number"] { 
            width: 100%; 
            padding: 10px 12px; 
            background: #0f172a; 
            border: 1px solid #334155; 
            color: #fff; 
            border-radius: 8px; 
            font-size: 14px; 
            transition: all 0.3s;
        }
        input:focus { outline: none; border-color: #38bdf8; box-shadow: 0 0 8px rgba(56, 189, 248, 0.4); }
        .row { display: flex; gap: 10px; }
        .col { flex: 1; }
        button { 
            width: 100%; 
            padding: 14px; 
            background: linear-gradient(135deg, #06b6d4, #3b82f6); 
            border: none; 
            color: #fff; 
            font-weight: bold; 
            border-radius: 8px; 
            cursor: pointer; 
            font-size: 16px; 
            margin-top: 15px; 
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
        }
        button:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(59, 130, 246, 0.6); }
        
        .result-box { 
            margin-top: 25px; 
            background: #0f172a; 
            padding: 20px; 
            border-radius: 12px; 
            border: 1px solid #334155;
            display: none; 
        }
        .match-header {
            font-size: 18px;
            font-weight: bold;
            color: #38bdf8;
            text-align: center;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 1px solid #1e293b;
        }
        .section-title {
            font-size: 13px;
            color: #94a3b8;
            text-transform: uppercase;
            margin: 15px 0 8px 0;
            letter-spacing: 1px;
        }
        .stat-grid-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 8px;
        }
        .stat-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }
        .stat-card {
            background: #1e293b;
            padding: 10px;
            border-radius: 8px;
            border-left: 3px solid #38bdf8;
            text-align: center;
        }
        .stat-label { font-size: 11px; color: #94a3b8; }
        .stat-value { font-size: 15px; font-weight: bold; color: #f8fafc; margin-top: 4px; }
    </style>
</head>
<body>

<div class="container">
    <h1>Oranmerkezi</h1>
    
    <div class="row">
        <div class="col form-group">
            <label>Ev Sahibi</label>
            <input type="text" id="homeTeam" placeholder="Örn: Beşiktaş">
        </div>
        <div class="col form-group">
            <label>Deplasman</label>
            <input type="text" id="awayTeam" placeholder="Örn: Galatasaray">
        </div>
    </div>

    <div class="form-group">
        <label>Maç Sonu Oranları (MS 1 - 0 - 2)</label>
        <div class="row">
            <input type="number" step="0.01" id="ms1" placeholder="MS 1">
            <input type="number" step="0.01" id="ms0" placeholder="MS 0">
            <input type="number" step="0.01" id="ms2" placeholder="MS 2">
        </div>
    </div>

    <div class="form-group">
        <label>İlk Yarı Oranları (İY 1 - 0 - 2)</label>
        <div class="row">
            <input type="number" step="0.01" id="iy1" placeholder="İY 1">
            <input type="number" step="0.01" id="iy0" placeholder="İY 0">
            <input type="number" step="0.01" id="iy2" placeholder="İY 2">
        </div>
    </div>

    <div class="row">
        <div class="col form-group">
            <label>2.5 Gol Üst Oranı</label>
            <input type="number" step="0.01" id="over25" placeholder="Üst Oranı">
        </div>
        <div class="col form-group">
            <label>KG Var Oranı</label>
            <input type="number" step="0.01" id="bttsVar" placeholder="KG Var Oranı">
        </div>
    </div>

    <button onclick="calculateAnalysis()">Kapsamlı Analiz Yap</button>

    <div class="result-box" id="resultArea">
        <div class="match-header" id="headerText">Maç Analizi</div>
        
        <div class="section-title">Maç Sonu (MS) Yüzdeleri</div>
        <div class="stat-grid-3">
            <div class="stat-card"><div class="stat-label">MS 1</div><div class="stat-value" id="valMS1">%0</div></div>
            <div class="stat-card" style="border-left-color: #f59e0b;"><div class="stat-label">MS 0</div><div class="stat-value" id="valMS0">%0</div></div>
            <div class="stat-card" style="border-left-color: #ec4899;"><div class="stat-label">MS 2</div><div class="stat-value" id="valMS2">%0</div></div>
        </div>

        <div class="section-title">İlk Yarı (İY) Yüzdeleri</div>
        <div class="stat-grid-3">
            <div class="stat-card" style="border-left-color: #10b981;"><div class="stat-label">İY 1</div><div class="stat-value" id="valIY1">%0</div></div>
            <div class="stat-card" style="border-left-color: #10b981;"><div class="stat-label">İY 0</div><div class="stat-value" id="valIY0">%0</div></div>
            <div class="stat-card" style="border-left-color: #10b981;"><div class="stat-label">İY 2</div><div class="stat-value" id="valIY2">%0</div></div>
        </div>

        <div class="section-title">Gol & Seçenek Analizi</div>
        <div class="stat-grid-2">
            <div class="stat-card" style="border-left-color: #8b5cf6;"><div class="stat-label">2.5 Gol Üst</div><div class="stat-value" id="valOver25">%0</div></div>
            <div class="stat-card" style="border-left-color: #06b6d4;"><div class="stat-label">KG Var</div><div class="stat-value" id="valBTTS">%0</div></div>
        </div>

        <div class="section-title">Otomatik Tahmin & Skorlar</div>
        <div class="stat-card" style="border-left-color: #34d399; margin-top: 5px; text-align: left; padding: 12px;">
            <div class="stat-label">İY / MS Tahmini & Gol (TG) Aralığı</div>
            <div class="stat-value" id="valIYMS_TG" style="color: #34d399; font-size: 13px; margin-top: 4px;">-</div>
        </div>
        <div class="stat-card" style="border-left-color: #f43f5e; margin-top: 8px; text-align: left; padding: 12px;">
            <div class="stat-label">Beklenen Skorlar (İY Skor & MS Skor)</div>
            <div class="stat-value" id="valScores" style="color: #fb7185; font-size: 13px; margin-top: 4px;">-</div>
        </div>
    </div>
</div>

<script>
    function calculateAnalysis() {
        const home = document.getElementById('homeTeam').value || 'Ev Sahibi';
        const away = document.getElementById('awayTeam').value || 'Deplasman';
        
        const m1 = parseFloat(document.getElementById('ms1').value) || 0;
        const m0 = parseFloat(document.getElementById('ms0').value) || 0;
        const m2 = parseFloat(document.getElementById('ms2').value) || 0;

        const i1 = parseFloat(document.getElementById('iy1').value) || 0;
        const i0 = parseFloat(document.getElementById('iy0').value) || 0;
        const i2 = parseFloat(document.getElementById('iy2').value) || 0;

        const o25 = parseFloat(document.getElementById('over25').value) || 1.80;
        const btts = parseFloat(document.getElementById('bttsVar').value) || 1.70;

        if (m1 === 0 || m2 === 0) {
            alert("Lütfen en azından Maç Sonu (MS 1 ve MS 2) oranlarını girin!");
            return;
        }

        // MS Oran Analizi
        let impMS1 = 1 / m1;
        let impMS0 = m0 > 0 ? (1 / m0) : 0.28;
        let impMS2 = 1 / m2;
        let totalMS = impMS1 + impMS0 + impMS2;
        
        let pMS1 = (impMS1 / totalMS) * 100;
        let pMS0 = (impMS0 / totalMS) * 100;
        let pMS2 = (impMS2 / totalMS) * 100;

        // İY Oran Analizi
        let pIY1 = 33.3, pIY0 = 40.0, pIY2 = 26.7;
        if (i1 > 0 && i2 > 0) {
            let impIY1 = 1 / i1;
            let impIY0 = i0 > 0 ? (1 / i0) : 0.40;
            let impIY2 = 1 / i2;
            let totalIY = impIY1 + impIY0 + impIY2;
            pIY1 = (impIY1 / totalIY) * 100;
            pIY0 = (impIY0 / totalIY) * 100;
            pIY2 = (impIY2 / totalIY) * 100;
        }

        let pOver = Math.min(Math.max((2.05 / o25) * 100, 20), 90);
        let pBTTS = Math.min(Math.max((1.95 / btts) * 100, 20), 88);

        // Ekranı Güncelle
        document.getElementById('headerText').innerText = `${home} vs ${away}`;
        document.getElementById('valMS1').innerText = `%${pMS1.toFixed(1)}`;
        document.getElementById('valMS0').innerText = `%${pMS0.toFixed(1)}`;
        document.getElementById('valMS2').innerText = `%${pMS2.toFixed(1)}`;

        document.getElementById('valIY1').innerText = `%${pIY1.toFixed(1)}`;
        document.getElementById('valIY0').innerText = `%${pIY0.toFixed(1)}`;
        document.getElementById('valIY2').innerText = `%${pIY2.toFixed(1)}`;

        document.getElementById('valOver25').innerText = `%${pOver.toFixed(1)}`;
        document.getElementById('valBTTS').innerText = `%${pBTTS.toFixed(1)}`;

        // Otomatik İY/MS, TG, Skor türetme
        let iyPred = pIY1 > pIY2 ? "1/1" : (pIY2 > pIY1 ? "2/2" : "0/0");
        if (pIY0 > 45) iyPred = "0/1 veya 0/2";

        let msPred = pMS1 > pMS2 ? "MS 1" : (pMS2 > pMS1 ? "MS 2" : "MS 0");
        let tgRange = pOver > 60 ? "3-5 Gol (2.5 ÜST)" : "2-3 Gol (2.5 ALT/ÜST Sınır)";
        
        let iyScore = pIY1 > pIY2 ? "1-0" : (pIY2 > pIY1 ? "0-1" : "0-0");
        let msScore = pMS1 > pMS2 ? (pOver > 60 ? "2-1" : "1-0") : (pMS2 > pMS1 ? (pOver > 60 ? "1-2" : "0-1") : "1-1");

        document.getElementById('valIYMS_TG').innerText = `İY/MS: ${iyPred} | Maç Tahmini: ${msPred} | TG: ${tgRange}`;
        document.getElementById('valScores').innerText = `İY Skor: ${iyScore} | MS Skor: ${msScore}`;
        
        document.getElementById('resultArea').style.display = 'block';
    }
</script>

</body>
</html>
